# ==============================================================================
# CodeQuest - Variables d'environnement (Exemple)
# Copier ce fichier sous le nom .env et adapter les valeurs locales.
# ATTENTION : Ne JAMAIS commiter le fichier .env contenant des secrets de production !
# ==============================================================================

# Environnement
NODE_ENV=development

# --- Applications ---
WEB_PORT=3000
API_PORT=4000
RUNNER_PORT=6000
ASSETS_PORT=5000

# URLs publiques
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000

# --- Base de données PostgreSQL ---
POSTGRES_USER=codequest_user
POSTGRES_PASSWORD=codequest_password_dev
POSTGRES_DB=codequest_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# --- Cache & Temps Réel (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Stockage Objet MinIO (Compatible S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_AVATARS=codequest-avatars
S3_BUCKET_ASSETS=codequest-assets

# --- Authentification & Sécurité (JWT / Argon2) ---
# Générer des chaînes aléatoires longues en production (ex: openssl rand -base64 32)
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production_key_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_key_67890
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=dev_cookie_secret_change_in_production

# --- Service Mail (MailHog en développement) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CodeQuest <no-reply@codequest.local>"

# --- Runner Sandbox ---
RUNNER_TIMEOUT_MS=5000
RUNNER_MAX_MEMORY_MB=128
RUNNER_MAX_CPU_SHARES=512
RUNNER_CONCURRENCY=2

# --- LiveKit WebRTC (Optionnel / Phase avancée) ---
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
